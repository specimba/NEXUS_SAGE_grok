# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# P2 dual-home pack archives (keep WIPE-DRILL.md / drill-log.md)
/packs/*.tar.gz

# arXiv Atom enrich cache (24h)
/artifacts/sage/arxiv-cache/

# HN Algolia Pulse cache (30m)
/artifacts/sage/hn-cache/

# GitHub unauth shelf cache (24h)
/artifacts/sage/github-cache/
/artifacts/sage/github-cache-test-*/

# OpenAlex Papers enrich cache (24h)
/artifacts/sage/openalex-cache/
/artifacts/sage/openalex-cache-test-*/

# Google News RSS spice cache (6h)
/artifacts/sage/gnews-cache/
/artifacts/sage/gnews-cache-test-*/
