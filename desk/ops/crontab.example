# NEXUS SAGE — A1–A3 standing automation (Europe/Istanbul weekday daytime)
# Spec: refs/OPS-A1-A3-AUTOMATION.md · install: desk/scripts/install-cron.sh
# Windows: Mon–Fri ~09:00–17:00 Istanbul · NO overnight · NO weekend · NO FORCE on A1
# Prefer $(command -v bun) when installing; example uses absolute bun path.

CRON_TZ=Europe/Istanbul

# A1 — STALE auto-ingest watch (natural STALE≥12h gate only; NEVER FORCE here)
*/30 9-16 * * 1-5 cd /workspace/nexus-sage/desk && /usr/local/bin/bun scripts/a1-stale-ingest.mjs >> /workspace/nexus-sage/logs/a1-stale.log 2>&1

# A2 — Digest DUE→WROTE→dual-home (digest:tick; pack:export only on WROTE)
*/6 9-16 * * 1-5 cd /workspace/nexus-sage/desk && /usr/local/bin/bun run a2:tick >> /workspace/nexus-sage/logs/a2-digest.log 2>&1
0 9 * * 1-5 cd /workspace/nexus-sage/desk && bun run a2:tick >> /workspace/nexus-sage/logs/a2-digest.log 2>&1  # A2 window-open catch-up

